---
import '../styles/global.css';

interface Props {
	title: string;
	description: string;
}

const { title, description } = Astro.props;
---

<!doctype html>
<html lang="en" class="[color-scheme:light_dark]">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<title>{title}</title>
	</head>
	<body class="bg-white font-mono text-base leading-[1.7] text-black [font-synthesis:none] dark:bg-black dark:text-white [&_a]:text-[#db2777] [&_a]:underline [&_a]:decoration-1 [&_a]:underline-offset-[0.2em] [&_a:hover]:decoration-2 [&_a:focus-visible]:outline-2 [&_a:focus-visible]:outline-offset-4 [&_a:focus-visible]:outline-black dark:[&_a:focus-visible]:outline-white">
		<div class="ml-[clamp(1.5rem,8vw,7rem)] mr-6 max-w-3xl">
			<header class="border-b border-neutral-300 pt-8 pb-5 dark:border-neutral-700">
				<nav aria-label="Main navigation" class="flex flex-wrap gap-x-8 gap-y-2">
					<a href="/" class="font-bold">Matt Ehlinger</a>
					<a href="/resume/" aria-current={Astro.url.pathname === '/resume/' || Astro.url.pathname === '/resume' ? 'page' : undefined}>resume</a>
				</nav>
			</header>
			<main id="main" class="pt-[clamp(3.5rem,10vw,6.5rem)] pb-20">
				<slot />
			</main>
		</div>
	</body>
</html>
